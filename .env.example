# Reown AppKit project ID — get a free one at https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional: custom Arbitrum RPC (Alchemy, Ankr, etc.) — falls back to public arb1.arbitrum.io/rpc
ARBITRUM_RPC_URL=

# Optional: custom Base / Optimism RPCs (source chains for bridging idle capital
# back to Arbitrum) — fall back to public mainnet.base.org / mainnet.optimism.io
BASE_RPC_URL=
OPTIMISM_RPC_URL=

# Optional: Enso (enso.finance) API key — enables in-app deposits into protocols
# beyond Aave (Compound, Curve, Pendle, Yearn, …) via the routing API. Without
# it, non-Aave pools fall back to a deep-link. Get one at https://shortcuts.enso.finance
ENSO_API_KEY=

# --- Open read API (scan, opportunities, pool-chart, keeper/address, execute-route) ---
# These public endpoints require an API key. A publishable (non-secret) key is
# baked in for first-party + docs use; set this to override it. Like a Stripe pk_
# key — safe to expose in the browser; the rate limits below, not secrecy, protect
# the API.
NEXT_PUBLIC_ARBIFLOW_API_KEY=af_pub_demo
# Extra server-side keys (comma-separated) for integrators who want higher limits
# / attribution. The publishable key above is always accepted too.
ARBIFLOW_API_KEYS=
# Per-key rate limit: max requests per window, and the window length in ms.
# (In-memory + best-effort per serverless instance; use a shared store in prod.)
API_RATE_LIMIT=60
API_RATE_WINDOW_MS=60000

# --- Contract deploy + testnet keeper (Foundry, contracts/) — keep REAL values in .env, never here ---
# DEPLOY-ONLY key, funded with Arbitrum Sepolia ETH from a faucet. Used by
# `forge script script/DeployDemo.s.sol` to deploy the stack. NOT read at runtime.
DEPLOYER_PK=
# Runtime keeper POOL (server-side only, never exposed to the browser). One BIP-39
# mnemonic seeds KEEPER_POOL_SIZE keeper EOAs (m/44'/60'/0'/0/i); each vault is
# sharded to one for parallel submission (no single-nonce bottleneck). Each keeper
# fronts gas and is reimbursed from the vault's own ETH reserve, so it only needs a
# small float (auto-topped-up below). Back-compat: if KEEPER_MNEMONIC is empty, a
# single-key pool is built from KEEPER_PK instead.
KEEPER_MNEMONIC=
KEEPER_POOL_SIZE=16
# KEEPER_PK=            # legacy single-key fallback (used only when no mnemonic)
# Gas-station funder (optional): auto-tops-up any pool keeper that dips below
# KEEPER_MIN_FLOAT, sending KEEPER_TOPUP each time. May reuse the deploy key.
# Without it, pre-fund the pool keepers manually.
GAS_FUNDER_PK=
KEEPER_MIN_FLOAT=0.02
KEEPER_TOPUP=0.05
# Arbitrum Sepolia RPC. Used by `forge script ... --rpc-url arbitrum_sepolia`
# and by the server-side keeper (falls back to viem's public RPC if unset).
ARBITRUM_SEPOLIA_RPC_URL=
# Optional: allocation signer key (must equal the factory's backendSigner).
# Defaults to the public demo key 0xA11CE, so the demo needs no on-chain setup.
BACKEND_PK=
